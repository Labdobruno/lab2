    {
      "chave": "desconto_alto",
      "titulo": "Descontos acima de 10% estão comendo receita",
      "quando": "desconto_medio > 0.10 && vendas >= amostra_minima",
      "impacto": "receita * desconto_medio / (1 - desconto_medio)",
      "acao": "Rever a alçada de desconto e exigir contrapartida (prazo, escopo, pagamento) em descontos acima de 10%.",
      "severidade": "media"
    },
    {
      "chave": "taxa_ganho_baixa",
      "titulo": "Taxa de ganho abaixo de 25%",
      "quando": "fechados >= amostra_minima && taxa_ganho < 0.25",
      "impacto": "(0.25 - taxa_ganho) * fechados * ticket_medio",
      "acao": "Olhar os motivos de perda e o passo de negociação; apertar a qualificação antes da proposta.",
      "severidade": "alta"
    },
    {
      "chave": "no_show_alto",
      "titulo": "Reuniões agendadas que não acontecem",
      "quando": "amostra_coorte >= amostra_minima && passo_realizada < 0.7",
      "impacto": "(0.7 - passo_realizada) * conv_agendada * amostra_coorte * (conv_ganho / conv_realizada) * ticket_medio",
      "acao": "Confirmar a reunião um dia antes, lembrar no dia e ter uma regra de remarcação.",
      "severidade": "media"
    },
    {
      "chave": "pipeline_parado",
      "titulo": "Dinheiro parado no pipeline",
      "quando": "valor_parado > 0 && valor_parado >= 0.2 * valor_aberto",
      "impacto": "valor_parado * taxa_ganho",
      "acao": "Revisar os negócios parados um a um: avançar, reagendar ou encerrar.",
      "severidade": "media"
    },
    {
      "chave": "perda_por_preco",
      "titulo": "Perdas concentradas em preço",
      "quando": "valor_perdido > 0 && valor_perdido_preco / valor_perdido > 0.3",
      "impacto": "valor_perdido_preco * taxa_ganho",
      "acao": "Testar condição de pagamento ou um pacote menor antes de ceder no preço.",
      "severidade": "media"
    },
    {
      "chave": "cac_acima_da_margem",
      "titulo": "Custo de aquisição maior que a margem da venda",
