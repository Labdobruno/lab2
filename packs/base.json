      "impacto": "(cac_medio - margem_percentual * ticket_medio) * vendas",
      "acao": "Rever ou cortar os canais com pior CAC (veja o ROI por canal).",
      "severidade": "alta"
    },
    {
      "chave": "churn_alto",
      "titulo": "Cancelamentos acima de 5% da receita recorrente",
