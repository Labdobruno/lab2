          "esforco": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "prazoDias": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "remover": {
            "type": "boolean"
          }
        },
        "required": [
          "chave"
        ],
        "additionalProperties": false
      }
