              "antecipacao": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "partes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fracao": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
