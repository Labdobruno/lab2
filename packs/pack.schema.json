{
  "title": "Pack do LAB V2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "versao": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "herda": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "descricao": {
      "type": "string"
    },
    "modelo": {
      "type": "string",
      "enum": [
        "b2b",
        "b2c",
        "misto"
      ]
    },
    "textos": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "calendario": {
      "type": "object",
      "properties": {
        "feriados": {
          "anyOf": [
            {
              "type": "string",
              "const": "BR"
            },
            {
              "type": "string",
              "const": "nenhum"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{2}-\\d{2}$"
              }
            }
          ]
        },
        "diasUteis": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "inicioCicloDia": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "mesInicioAno": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "fuso": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "funis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chave": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
