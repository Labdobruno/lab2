          "papel": {
            "type": "string",
            "enum": [
              "tentativa",
              "contato",
              "agendamento",
              "reuniao_realizada",
              "no_show",
              "proposta_enviada",
              "follow_up",
              "visita",
              "reuniao_cs",
              "indicacao_pedida",
              "nota",
              "outro"
