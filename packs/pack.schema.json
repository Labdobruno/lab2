            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impacto": {
            "type": "string",
            "minLength": 1
          },
          "dimensao": {
            "type": "string",
            "enum": [
              "contribuicao",
              "receita",
              "caixa",
              "capacidade"
            ]
          },
          "tipo": {
            "type": "string",
            "enum": [
              "problema",
              "risco",
              "oportunidade",
              "gargalo",
              "anomalia",
              "contradicao",
              "hipotese",
              "investigacao"
            ]
          },
          "acao": {
            "type": "string",
            "minLength": 1
          },
          "severidade": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baixa"
            ]
          },
          "mecanismo": {
            "type": "string"
          },
          "rivais": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "distingue": {
            "type": "string"
          },
          "intervencoes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "requer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remover": {
            "type": "boolean"
          }
