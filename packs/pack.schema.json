        "type": "object",
        "properties": {
          "chave": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "type": "string",
            "enum": [
              "pago",
              "organico",
              "indicacao",
              "outbound",
              "parceiro",
              "evento",
              "base",
              "outro"
            ]
          },
          "origemDeLead": {
            "type": "boolean"
          },
          "pai": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "remover": {
            "type": "boolean"
          }
        },
        "required": [
          "chave"
        ],
        "additionalProperties": false
      }
    },
    "motivosPerda": {
      "type": "array",
