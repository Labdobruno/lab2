                "amostraMin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ref": {
                  "type": "number"
                },
                "histerese": {
                  "type": "object",
                  "properties": {
                    "folga": {
                      "type": "number",
                      "minimum": 0
                    },
                    "dias": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "intervalo": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "met",
                "op"
              ],
              "additionalProperties": false
            }
          },
