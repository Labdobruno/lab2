              "type": "object",
              "properties": {
                "chave": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "nome": {
                  "type": "string",
                  "minLength": 1
                },
                "papel": {
                  "type": "string",
                  "enum": [
                    "lead",
                    "contato",
                    "qualificado",
                    "agendada",
                    "realizada",
                    "oportunidade",
                    "proposta",
                    "negociacao",
                    "ganho",
                    "perdido",
                    "onboarding",
                    "ativo",
                    "renovacao",
                    "expansao",
                    "churn",
                    "intermediaria"
                  ]
                },
                "prazoDias": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "descricao": {
                  "type": "string"
                }
              },
              "required": [
                "chave",
                "nome",
                "papel"
              ],
              "additionalProperties": false
            }
          },
          "remover": {
            "type": "boolean"
          }
        },
        "required": [
          "chave"
        ],
        "additionalProperties": false
      }
    },
    "atividades": {
      "type": "array",
