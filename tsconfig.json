{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "baseUrl": ".",
    "paths": {
      "@lab/nucleo": [
        "packages/nucleo/src/index.ts"
      ],
      "@lab/conectores": [
        "packages/conectores/src/index.ts"
      ],
      "@lab/metricas": [
        "packages/metricas/src/index.ts"
      ],
      "@lab/planejamento": [
        "packages/planejamento/src/index.ts"
      ],
      "@lab/ciclos": [
        "packages/ciclos/src/index.ts"
      ],
      "@lab/hipoteses": [
        "packages/hipoteses/src/index.ts"
      ],
      "@lab/studio": [
        "packages/studio/src/index.ts"
      ],
      "@lab/dia": [
        "packages/dia/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "apps/*/src",
    "scripts"
  ]
}