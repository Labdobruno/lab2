{
  "name": "lab-v2",
  "private": true,
  "description": "LAB V2 \u2014 intelig\u00eancia de receita (funil borboleta), mold\u00e1vel por opera\u00e7\u00e3o.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pack:validar": "tsx scripts/pack-validar.ts",
    "pack:novo": "tsx scripts/pack-novo.ts",
    "pack:schema": "tsx scripts/pack-schema.ts",
    "db:local": "bash scripts/db-local.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}